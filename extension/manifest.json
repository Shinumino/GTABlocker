{
  "manifest_version": 3,
  "name": "GTA Blocker",
  "version": "0.1.0",
  "description": "Covers anything about GTA on the pages you visit with a short note.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{b5f8e9f0-9312-4fa5-90f0-2c21a45ed256}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_popup": "pages/menu.html",
    "default_area": "navbar",
    "default_title": "GTA Blocker",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "pages/settings.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "lib/matcher.js",
      "lib/settings.js",
      "lib/tabs.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/matcher.js",
        "lib/cover.js",
        "lib/media.js",
        "lib/sites.js",
        "lib/settings.js",
        "lib/tabs.js",
        "lib/page.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
